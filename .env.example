# JARVIS OS — example environment file.
# Copy to `.env` and fill in your own values. `.env` is gitignored —
# never commit real API keys.

# --- LLM providers -------------------------------------------------------
JARVIS_LLM_DEFAULT_PROVIDER=ollama
# Optional secondary provider, only called if the default provider's
# request fails (timeout/rate-limit/connection error).
JARVIS_LLM_FALLBACK_PROVIDER=

JARVIS_OPENAI_ENABLED=false
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_CHAT_MODEL=gpt-4o-mini

JARVIS_OLLAMA_ENABLED=true
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

JARVIS_GEMINI_ENABLED=false
JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Voice: STT ------------------------------------------------------------
JARVIS_STT_ENABLED=true
JARVIS_STT_BACKEND=whisper_local
JARVIS_STT_MODEL=base

# --- Voice: TTS --------------------------------------------------------------
JARVIS_TTS_ENABLED=true
JARVIS_TTS_BACKEND=piper
JARVIS_TTS_STREAMING=true
JARVIS_TTS_SPEAK_REPLIES=false

JARVIS_PIPER_VOICE=en_US-lessac-medium
JARVIS_EDGE_TTS_VOICE=en-US-AriaNeural
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Voice: interaction ------------------------------------------------------
JARVIS_VOICE_MODE=push_to_talk
JARVIS_VOICE_CONTINUOUS_CONVERSATION=false
JARVIS_VOICE_INTERRUPT_ENABLED=true

# --- Wake word ---------------------------------------------------------------
JARVIS_WAKE_ENABLED=false
JARVIS_WAKE_ENGINE=none
JARVIS_WAKE_KEYWORDS=jarvis
JARVIS_WAKE_ACCESS_KEY=
