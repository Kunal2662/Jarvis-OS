/* =============================================================================
 * JARVIS OS — "light" theme
 * See src/jarvis/ui/themes/palette.py:LIGHT_PALETTE
 * =========================================================================== */

QWidget {
    background-color: #F7F9FC;
    color: #0B1B2B;
    font-family: "Inter", "Segoe UI", "SF Pro Text", "Helvetica Neue", "Arial", sans-serif;
    font-size: 14px;
    selection-background-color: #0077B6;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog { background-color: #F7F9FC; }

QFrame#surface, QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D6DCE5;
    border-radius: 8px;
}

QLabel[role="muted"] { color: #5B6B7E; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #0B1B2B;
    border: 1px solid #D6DCE5;
    border-radius: 6px;
    padding: 6px 10px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border-color: #0077B6;
}
QPushButton:focus {
    outline: none;
    border: 2px solid #0077B6;
}

QPushButton {
    background-color: #FFFFFF;
    color: #0B1B2B;
    border: 1px solid #D6DCE5;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover   { border-color: #0077B6; color: #0077B6; }
QPushButton:pressed { background-color: #EEF2F7; }
QPushButton[variant="primary"] {
    background-color: #0077B6; color: #FFFFFF; border: none; font-weight: 600;
}
QPushButton[variant="primary"]:hover { background-color: #005F8E; }
QPushButton[variant="danger"] { background-color: #D62839; color: #FFFFFF; border: none; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: #EEF2F7; border: none; width: 10px; height: 10px;
}
QScrollBar::handle { background: #D6DCE5; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #0077B6; }

QMenuBar, QMenu { background-color: #FFFFFF; color: #0B1B2B; border: 1px solid #D6DCE5; }
QMenu::item:selected { background-color: #EEF2F7; color: #0077B6; }

QTabWidget::pane { border: 1px solid #D6DCE5; border-radius: 6px; }
QTabBar::tab { background: #EEF2F7; color: #5B6B7E; padding: 8px 16px; border: 1px solid transparent; }
QTabBar::tab:selected { background: #FFFFFF; color: #0077B6; border-color: #D6DCE5; border-bottom-color: transparent; }

QStatusBar { background-color: #FFFFFF; color: #5B6B7E; border-top: 1px solid #D6DCE5; }
